# Base URL of the backend API. Leave empty to use the Vite dev proxy ("/api").
VITE_API_URL=

# Базовый URL задеплоенного Mini App (без query-параметров), например
# https://telegram-mini-shop.netlify.app — используется в разделе
# "Управление" → "Реквизиты" для отображения ссылки `?shop=ID` для BotFather.
# Необязательно: по умолчанию используется https://telegram-mini-shop.netlify.app
VITE_MINI_APP_URL=

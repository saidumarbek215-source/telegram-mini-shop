# Telegram bot token from @BotFather
BOT_TOKEN=

# Neon PostgreSQL connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Telegram numeric ID of the store owner.
# - Receives new order notifications
# - Identifies the owner inside the Mini App so the "Управление" admin section is shown
OWNER_TELEGRAM_ID=

# Port for the Express server
PORT=3001

# Public URL of the deployed Mini App (used in bot messages, optional)
WEBAPP_URL=

# --- Демо-магазин (id=1), создаётся при `npm run seed` ---
# Сами по себе эти переменные сервером не используются: бот-токен и владелец
# каждого магазина хранятся в таблице `shops` (поля `bot_token` и
# `owner_telegram_id`). Переменные ниже нужны только для заполнения демо-магазина.

# Telegram bot token from @BotFather (для демо-магазина id=1)
BOT_TOKEN=

# Telegram numeric ID владельца демо-магазина (id=1).
# - Получает уведомления о новых заказах
# - Определяет доступ к разделу "Управление" внутри Mini App
OWNER_TELEGRAM_ID=

# --- Общие настройки ---

# Neon PostgreSQL connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Port for the Express server
PORT=3001

# Публичный URL задеплоенного Mini App (без query-параметров).
# Используется как база для ссылок вида `<WEBAPP_URL>?shop=<ID>`
# в ответе POST /api/shops/register и в сообщениях бота.
WEBAPP_URL=

# --- AI-функции бота (см. server/src/routes/telegram.js) ---

# Ключ ImgBB (https://api.imgbb.com/1/upload) для загрузки фото товаров,
# присланных владельцем магазина в бот.
IMGBB_API_KEY=

# Ключ Anthropic API (https://console.anthropic.com/) для распознавания
# товаров на фото и AI-консультанта для покупателей (модель Claude Haiku).
ANTHROPIC_API_KEY=

# --- Локальное хранилище изображений ---

# Публичный базовый URL сервера (без слеша на конце).
# Используется для формирования URL загруженных изображений.
BASE_URL=https://api.finexia.uz

# Путь на диске, куда сохраняются загруженные изображения.
# Директория должна быть доступна Express для отдачи статики по /uploads.
UPLOAD_DIR=/var/www/uploads

# Telegram bot token from @BotFather
BOT_TOKEN=

# Neon PostgreSQL connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Password for /admin login
ADMIN_PASSWORD=

# Telegram numeric ID of the store owner (receives new order notifications)
OWNER_TELEGRAM_ID=

# Secret used to sign admin auth tokens
JWT_SECRET=change-me-to-a-random-string

# Port for the Express server
PORT=3001

# Public URL of the deployed Mini App (used in bot messages, optional)
WEBAPP_URL=
